# LiveKit connection for the agent worker
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-secret

# opencode REST server the agent bridges to
OPENCODE_URL=http://127.0.0.1:4096

# Model used for voice replies (providerID/modelID in opencode)
VOICE_MODEL=zai-coding-plan/ling-3.0-flash-fin-free

# Speech stack (OpenAI-compatible endpoints)
SPEACHES_URL=http://127.0.0.1:8000/v1
STT_MODEL=Systran/faster-whisper-small
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
